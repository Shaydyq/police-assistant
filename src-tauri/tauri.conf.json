{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Majestic Law Assistant",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "windows": [
      {
        "title": "Majestic Law Assistant",
        "width": 1200,
        "height": 800
      }
    ],
    "bundle": {
      "active": true,
      "targets": ["msi", "nsis"],
      "identifier": "com.majestic.lawassistant",
      "icon": ["icons/icon.ico", "icons/icon.png"],
      "resources": []
    }
  }
}
